# ─── Database (Supabase Postgres) ───────────────────────────────────────────
# Pooled connection (port 6543) — used by the app at runtime.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
DATABASE_URL=
# Direct connection (port 5432) — used by Prisma for migrations only.
# Format: postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DIRECT_URL=

# ─── Supabase ───────────────────────────────────────────────────────────────
# Project URL, e.g. https://abcdefghij.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# anon / public key — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — SERVER ONLY, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# ─── Stripe (test mode — fill these in Phase 4) ─────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_FAMILY_MONTHLY=
STRIPE_PRICE_FAMILY_PLUS_MONTHLY=
STRIPE_PRICE_FAMILY_YEARLY=
STRIPE_PRICE_FAMILY_PLUS_YEARLY=

# ─── AI services ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
FAL_API_KEY=
ELEVENLABS_API_KEY=

# ─── Email (Resend) ─────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Tom from Bedtime Library <tom@bedtimelibrary.com>"
ADMIN_NOTIFICATION_EMAIL=th@clglawaz.com

# ─── App ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Monitoring (fill these in Phase 9) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
