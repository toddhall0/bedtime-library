// Prisma schema for Bedtime Library
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Pooled connection (port 6543, pgbouncer) — used by the app at runtime.
  url       = env("DATABASE_URL")
  // Direct connection (port 5432) — used by Prisma for migrations.
  directUrl = env("DIRECT_URL")
}

// Mirrors Supabase auth.users via shared UUID. Application-level user data
// (name, role, timezone, etc.) lives here; auth-level data (password hash,
// email confirmation, OAuth identities) lives in Supabase's auth schema.
model User {
  id        String   @id @default(uuid()) // matches auth.users.id
  email     String   @unique
  name      String?
  role      String   @default("parent") // "parent" | "narrator"
  avatarUrl String?
  timezone  String   @default("America/Los_Angeles")
  isAdmin   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("users")
}
